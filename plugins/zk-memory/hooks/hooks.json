{
  "description": "Digest at session start and after compaction, recall before each prompt, save on compaction and session end",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {"type": "command", "command": "zk", "args": ["memory", "hook", "start"], "timeout": 15}
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command", "command": "zk", "args": ["memory", "hook", "recall"], "timeout": 10}
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {"type": "command", "command": "zk", "args": ["memory", "hook", "extract"], "timeout": 5}
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {"type": "command", "command": "zk", "args": ["memory", "hook", "extract"], "timeout": 5}
        ]
      }
    ]
  }
}
